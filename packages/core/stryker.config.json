{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": { "command": "npx vitest run --no-isolate --maxWorkers=1" },
  "coverageAnalysis": "off",
  "mutate": [
    "src/policy.ts",
    "src/decisions.ts",
    "src/impact.ts",
    "src/hierarchy.ts",
    "src/guards.ts",
    "src/analysis/fingerprint.ts",
    "src/analysis/states.ts"
  ],
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "tempDirName": ".stryker-tmp",
  "concurrency": 4,
  "thresholds": { "high": 80, "low": 60, "break": 25 }
}
