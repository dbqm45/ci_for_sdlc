{
  "name": "continuous-intelligence-sdlc",
  "version": "0.1.13",
  "private": true,
  "description": "Continuous Intelligence for Product & Software Definition — AI quality gate across Jira, Confluence and Figma",
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/web",
    "packages/sandbox"
  ],
  "scripts": {
    "dev": "node scripts/check-path.mjs && concurrently -n server,web -c blue,magenta \"npm run dev -w @ci/server\" \"npm run dev -w @ci/web\"",
    "build": "node scripts/check-path.mjs && npm run build -w @ci/web",
    "start": "node scripts/ensure-web.mjs && npm run start -w @ci/server",
    "local": "node scripts/local.mjs",
    "test": "npm run test -w @ci/core && npm run test -w @ci/server && npm run test -w @ci/web && npm run test -w @ci/sandbox",
    "test:coverage": "npm run test:coverage -w @ci/core && npm run test:coverage -w @ci/server && npm run test -w @ci/web && npm run test -w @ci/sandbox",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:live-mock": "playwright test -c playwright.live-mock.config.ts",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:contract": "npm run test:contract -w @ci/server",
    "test:contract:update": "npm run test:contract:update -w @ci/server",
    "test:mutation": "npm run test:mutation -w @ci/core",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "typecheck": "tsc -p packages/core && tsc -p packages/server && tsc -p packages/web && tsc -p packages/sandbox && tsc -p e2e",
    "analyze": "npm run analyze --silent -w @ci/server --",
    "release": "node scripts/release.mjs",
    "sandbox:atlassian": "node scripts/sandbox-atlassian.mjs",
    "sandbox:seed": "tsx packages/sandbox/src/cli.ts seed",
    "sandbox:mutate": "tsx packages/sandbox/src/cli.ts mutate",
    "sandbox:reset": "tsx packages/sandbox/src/cli.ts reset",
    "sandbox:status": "tsx packages/sandbox/src/cli.ts status",
    "sandbox:figma-plugin": "tsx packages/sandbox/src/figma-plugin.ts",
    "lint:commit": "node scripts/check-commit-message.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "qs": "^6.16.0",
    "shell-quote": "^1.12.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
