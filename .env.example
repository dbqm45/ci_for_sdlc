# Copy to your environment (or a secrets manager). The app never stores these values.

# --- Integrations ---
JIRA_API_TOKEN=
# Optional: defaults to JIRA_API_TOKEN
CONFLUENCE_API_TOKEN=
FIGMA_TOKEN=

# --- One-click Atlassian connection (instead of JIRA_API_TOKEN) ---
# token (default): JIRA_API_TOKEN + site URL and e-mail in Settings. oauth: "Connect Atlassian" button in Settings.
# CI_CONNECT_MODE=oauth
# From the OAuth 2.0 (3LO) app in developer.atlassian.com/console/myapps
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# The address people open the app at; the callback is <CI_PUBLIC_URL>/api/connections/atlassian/callback
# CI_PUBLIC_URL=http://localhost:4317
# Optional: space-separated scopes, if the app needs others than the defaults
# ATLASSIAN_SCOPES=
# oauth mode also needs CI_ENCRYPTION_KEY: the connection is stored encrypted with it

# --- AI provider (choose one in Settings → AI provider) ---
ANTHROPIC_API_KEY=
# Amazon Bedrock uses the standard AWS credential chain, e.g.:
# AWS_PROFILE=my-profile
# AWS_REGION=eu-central-1
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
CUSTOM_AI_API_KEY=

# --- Security ---
# Enables "Encrypt stored context" (AES-256-GCM at rest)
CI_ENCRYPTION_KEY=
# Required header x-ci-webhook-secret for /api/webhooks/*
CI_WEBHOOK_SECRET=

# --- Server ---
# CI_DATA_DIR=.ci-data
# PORT=4317
# HOST=127.0.0.1
